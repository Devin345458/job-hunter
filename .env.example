# Claude on Devin's personal subscription, through the Claude Agent SDK: a token from
# `claude setup-token` on his personal account. With it set, every step runs on the subscription.
NUXT_CLAUDE_CODE_OAUTH_TOKEN=
# Claude API (Console key). Used only without the token above, or for a step mapped to api below.
NUXT_ANTHROPIC_API_KEY=
# Steps to keep on the Console key while it is set, e.g. enrich=api (or *=api for all).
# NUXT_AI_STEP_BACKENDS=
# Claude Code processes at once (about 190 MB each).
# NUXT_AGENT_CONCURRENCY=3
# Thinking on the subscription: off (default), on, or a list of steps (tailor,cover_letter). The 5.x
# models think adaptively either way, as on the API key; this changes only claude-haiku-4-5.
# NUXT_AGENT_THINKING=off

# JSearch (RapidAPI)
NUXT_JSEARCH_API_KEY=

# Adzuna
NUXT_ADZUNA_APP_ID=
NUXT_ADZUNA_API_KEY=

# Database
NUXT_DATABASE_PATH=./data/job-hunter.db

# Port for `npm run dev` and the docker compose host port (default 3000)
# NUXT_PORT=3000

# Login (required in production). Hash: node scripts/hash-password.mjs
NUXT_AUTH_PASSWORD_HASH=
NUXT_SESSION_PASSWORD=

# Throwaway employer form for testing submits (16+ chars)
NUXT_SANDBOX_TOKEN=
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Claude model and daily spend cap (the cap counts API key calls only)
# NUXT_AI_MODEL=claude-opus-5-5
# NUXT_AI_FALLBACK_MODEL=claude-haiku-4-5
# NUXT_DAILY_AI_BUDGET_USD=10

# GitHub token for demo repos and the resume site (used only on approve)
NUXT_GITHUB_TOKEN=

# GitHub evidence (Settings > GitHub evidence): read-only fine-grained tokens with Contents,
# Metadata, and Pull requests read access. A fine-grained token covers one owner, so list one for
# your account and one per organization, comma separated. NUXT_GITHUB_READ_TOKEN takes a single
# token. With neither set, the indexer uses NUXT_GITHUB_TOKEN.
# NUXT_GITHUB_READ_TOKENS=
# NUXT_GITHUB_READ_TOKEN=
# In the container git runs as this unprivileged user (created in the Dockerfile).
# NUXT_REPO_UID=10002

# Set to false to turn off the cron schedule on this server (every Orca worktree does). Production leaves it unset.
# NUXT_SCHEDULER_ENABLED=false

# Devin's claude-self-reflect memory server (MCP over HTTP). Leads from his past Claude sessions on
# open questions and in the question chat. Empty turns it off. Production reaches it over Tailscale.
# NUXT_MEMORY_MCP_URL=http://127.0.0.1:7391/mcp
# Host header sent when the URL's host is not local; the daemon rejects any other Host.
# NUXT_MEMORY_MCP_HOST_HEADER=127.0.0.1:7391
